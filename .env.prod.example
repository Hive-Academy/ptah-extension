# =============================================================================
# Ptah License Server — PRODUCTION ENVIRONMENT (TEMPLATE)
# =============================================================================
# This file IS committed and contains no real values. Copy it to .env.prod and
# fill in every CHANGE_ME_* / PASTE_* placeholder:
#
#   cp .env.prod.example .env.prod        # .env.prod is gitignored
#
# Its key set is kept in lockstep with .env.prod on purpose. An out-of-sync
# template is what previously hid UNSUBSCRIBE_TOKEN_SECRET (boot-fatal) and
# carried 13 dead keys. If you add or remove a key, change BOTH files.
#
# .env.prod is the single source of truth for production env. The deploy action
# reads it from the ENV_PROD_FILE GitHub secret and OVERWRITES the droplet copy
# on every deploy (deploy-server.yml:83) — never hand-edit env on the droplet.
#
# After ANY change to .env.prod:
#   gh secret set ENV_PROD_FILE < .env.prod
#
# Legend:
#   [FATAL]    missing/blank -> the container fails to boot
#   [REQUIRED] boots, but the owning feature is broken or fails closed
#   [OPTIONAL] unset is a supported state; the feature degrades gracefully
#
# FORMAT RULES: LF line endings only, no quotes around values, no inline
# comments after a value. This file is parsed both by --env-file
# (interpolation) and by env_file: (container env); CRLF or inline comments
# can end up inside a value in one parser but not the other.
# =============================================================================


# =============================================================================
# DATABASE (self-hosted PostgreSQL container)
# =============================================================================
# ⚠️ DO NOT ROTATE POSTGRES_PASSWORD BY EDITING THIS FILE. Postgres only reads
# it when initializing an EMPTY data volume, and ptah_postgres_prod_data
# already has data. Changing it here rebuilds DATABASE_URL with a password the
# DB role does not have -> the license server cannot connect. Rotate with
# ALTER ROLE in psql FIRST, then update this file.
POSTGRES_USER=ptah
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
POSTGRES_DB=ptah_db

# Inert for the container: docker-compose.prod.yml:63 sets DATABASE_URL in the
# environment: block, which outranks env_file:. Kept because host-side
# prisma commands run from /opt/ptah-extension do read it.
DATABASE_URL=postgresql://ptah:CHANGE_ME_same_as_POSTGRES_PASSWORD@postgres:5432/ptah_db


# =============================================================================
# SERVER
# =============================================================================
PORT=3000
NODE_ENV=production

# CORS origin allowlist + link base in transactional email (main.ts:74).
FRONTEND_URL=https://ptah.live

# Mirrors Dockerfile:129 exactly; redundant but harmless.
NODE_OPTIONS=--max-old-space-size=450


# =============================================================================
# JWT  (identity.module.ts:70)
# =============================================================================
# [FATAL] — the JwtModule factory throws when unset.
# Rotating logs out every active session.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# RENAMED from JWT_EXPIRATION, which has no reader anywhere in the codebase.
# The value is unchanged and identical to the fallback the code already used,
# so this rename is behavior-neutral (identity.module.ts:80).
JWT_EXPIRES_IN=7d


# =============================================================================
# ADMIN ACCESS
# =============================================================================
# [REQUIRED] x-api-key for the machine-to-machine admin endpoints
# (admin-api-key.guard.ts:57). Rotating breaks any client holding the old key.
ADMIN_API_KEY=CHANGE_ME_openssl_rand_hex_32

# [REQUIRED] Comma-separated email allowlist for /api/v1/admin/*
# (admin-emails.ts:49). AdminGuard FAILS CLOSED when blank — nobody is an
# admin. This allowlist is the only thing in front of the admin dashboard.
ADMIN_EMAILS=admin@example.com


# =============================================================================
# WORKOS AUTHENTICATION
# =============================================================================
# [FATAL] — the provider factory throws when unset (workos.provider.ts:48).
WORKOS_API_KEY=PASTE_WORKOS_LIVE_API_KEY
# [REQUIRED]
WORKOS_CLIENT_ID=PASTE_WORKOS_CLIENT_ID
WORKOS_REDIRECT_URI=https://api.ptah.live/api/v1/auth/callback
WORKOS_LOGOUT_REDIRECT_URI=https://ptah.live


# =============================================================================
# PADDLE BILLING
# =============================================================================
# [FATAL] — the provider factory throws when unset (paddle.provider.ts:180).
PADDLE_API_KEY=PASTE_PADDLE_LIVE_API_KEY

# [REQUIRED] Webhook HMAC verification. The provider only warns when unset, but
# every inbound Paddle webhook is then rejected — subscriptions silently stop
# provisioning.
PADDLE_WEBHOOK_SECRET=PASTE_PADDLE_NOTIFICATION_SECRET

# Currently DISABLED in production. The literal string 'true' is the only
# enabling value (checkout.config.ts:21). Preserved as-is: flipping this opens
# paid Builders checkout and is a launch decision, not config cleanup.
BUILDERS_CHECKOUT_ENABLED=false

# [REQUIRED when checkout is enabled]
PADDLE_PRICE_ID_BUILDERS_MONTHLY=PASTE_PADDLE_PRICE_ID_MONTHLY
PADDLE_PRICE_ID_BUILDERS_YEARLY=PASTE_PADDLE_PRICE_ID_YEARLY


# =============================================================================
# EMAIL (Resend)
# =============================================================================
# [FATAL] — the provider factory throws when unset (resend.provider.ts:58).
# This is TRANSACTIONAL email (magic links, license mail) and is unrelated to
# the marketing webhook below.
RESEND_API_KEY=PASTE_RESEND_API_KEY
FROM_EMAIL=help@ptah.live
FROM_NAME=Ptah Team


# =============================================================================
# MARKETING / UNSUBSCRIBE
# =============================================================================
# [FATAL] — UnsubscribeTokenService.onModuleInit() throws when this is missing
# or shorter than 32 characters (unsubscribe-token.service.ts:32).
# ⚠️ DO NOT ROTATE. Unsubscribe tokens are deliberately immortal (no expiry,
# for CAN-SPAM trust). A new secret invalidates every unsubscribe link in every
# email already sent.
UNSUBSCRIBE_TOKEN_SECRET=CHANGE_ME_openssl_rand_hex_32

# [REQUIRED before the first marketing campaign] — currently UNSET, which is
# why nothing has broken: with no endpoint configured in the Resend dashboard,
# nothing calls /webhooks/resend and the guard never runs.
#
# What it buys you: /webhooks/resend consumes email.bounced, email.complained
# and email.delivery_delayed and flips the recipient to opted-out
# (marketing.service.ts:431-462). Without it there is NO bounce or
# spam-complaint suppression — you keep mailing hard-bounced addresses and
# people who reported you, which is what destroys sender reputation and is a
# CAN-SPAM/GDPR problem once campaigns start going out.
#
# Blank behaves exactly as absent (resend-webhook.guard.ts:18 rejects with 401),
# so leaving it empty preserves today's behavior. Fill it from the Svix signing
# secret in the Resend dashboard when you enable webhooks; the whsec_ prefix is
# stripped by the guard, so either form works.
RESEND_WEBHOOK_SECRET=

# [REQUIRED] Physical postal address — CAN-SPAM/GDPR requirement rendered into
# marketing email footers (template-render.service.ts:70). Was absent in prod.
MARKETING_POSTAL_ADDRESS=PASTE_POSTAL_ADDRESS


# =============================================================================
# LICENSE RESPONSE SIGNING (Ed25519)
# =============================================================================
# ⚠️ PAIRED KEY — DO NOT REGENERATE. The shipped VS Code extension embeds the
# matching PUBLIC key at
# libs/shared/src/lib/constants/environment.constants.ts:62. A new pair means
# every installed client rejects this server signatures until that constant is
# updated AND the extension is reshipped.
LICENSE_SIGNING_PRIVATE_KEY=PASTE_ED25519_PRIVATE_KEY_BASE64_DER_PKCS8


# =============================================================================
# SENTRY  (instrument.ts)
# =============================================================================
# Blank => Sentry init is skipped entirely, no crash.
SENTRY_DSN=


# =============================================================================
# MAGIC LINK
# =============================================================================
MAGIC_LINK_TTL_MS=300000


# =============================================================================
# GOOGLE CALENDAR / MEET — BUILDERS SESSIONS
# =============================================================================
# Unset => GET /api/v1/members/sessions returns an empty list and attendee sync
# no-ops. Non-fatal by design.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Master (non-instance) recurring event id. Blank disables attendee sync.
BUILDERS_SESSION_EVENT_ID=


# =============================================================================
# REMOVED 2026-08-22 — zero readers anywhere in libs/ or apps/:
#   ADMIN_SECRET
#   JWT_EXPIRATION                       (renamed to JWT_EXPIRES_IN above)
#   PADDLE_PRICE_ID_PRO_MONTHLY
#   PADDLE_PRICE_ID_PRO_YEARLY
#   PADDLE_DISCOUNT_ID_BUILDERS_MONTHLY
#   PADDLE_DISCOUNT_ID_BUILDERS_YEARLY
#   TRIAL_DURATION_DAYS
#   DISCOURSE_URL                        - forum decommissioned by
#   DISCOURSE_SSO_SECRET                 - TASK_2026_177
#   DISCOURSE_API_KEY                    -
#   DISCOURSE_API_USERNAME               -
#   DISCOURSE_BUILDERS_GROUP             -
#   API_PUBLIC_URL                       -
#
# ⚠️ DISCOURSE_SSO_SECRET and DISCOURSE_API_KEY were LIVE credentials. Removing
# them here stops this server using them; it does not stop anyone else. REVOKE
# them at the source. See .ptah/specs/task_2026_177/decommission-runbook.md.
# =============================================================================


# =============================================================================
# UNSET [OPTIONAL] VARS — documented so they stay discoverable, left unset
# because their defaults are correct today.
# =============================================================================
#   MARKETING_UNSUBSCRIBE_BASE_URL   falls back to FRONTEND_URL
#   SSE_HEARTBEAT_INTERVAL           defaults to 30000 (events.controller.ts:57)
#   SENTRY_TRACES_SAMPLE_RATE        defaults to 1.0 in production
#   SENTRY_SEND_PII                  defaults to true; only 'false' disables
#   YOUTUBE_API_KEY                  metadata fetches skip when unset
#   CIRCLE_API_TOKEN                 Circle provisioning no-ops when unset
#   CIRCLE_COMMUNITY_ID
#   CIRCLE_DEFAULT_SPACE_GROUP_ID
