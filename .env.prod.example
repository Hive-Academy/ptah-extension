# =============================================================================
# Ptah License Server - Production Environment
# =============================================================================
# Copy to .env.prod and fill in all values.
# NEVER commit .env.prod to version control!
# =============================================================================

# =============================================================================
# DATABASE (Self-Hosted PostgreSQL)
# =============================================================================
POSTGRES_USER=ptah
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_32
POSTGRES_DB=ptah_db

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://ptah.live

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRATION=7d

# =============================================================================
# ADMIN API SECURITY
# =============================================================================
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ADMIN_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# =============================================================================
# WORKOS AUTHENTICATION
# =============================================================================
WORKOS_API_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WORKOS_CLIENT_ID=client_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WORKOS_REDIRECT_URI=https://api.ptah.live/api/auth/callback
WORKOS_LOGOUT_REDIRECT_URI=https://ptah.live

# =============================================================================
# PADDLE PAYMENT PROCESSING
# =============================================================================
PADDLE_API_KEY=pdl_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PADDLE_WEBHOOK_SECRET=pdl_ntfset_XXXXXXXXXXXXXXXXXXXXXXXX
PADDLE_PRICE_ID_PRO_MONTHLY=pri_XXXXXXXXXXXXXXXXXXXXXXXX
PADDLE_PRICE_ID_PRO_YEARLY=pri_XXXXXXXXXXXXXXXXXXXXXXXX

# =============================================================================
# EMAIL SERVICE (Resend)
# =============================================================================
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FROM_EMAIL=help@ptah.live
FROM_NAME=Ptah Team

# =============================================================================
# DISCOURSE — BUILDERS FORUM (SSO provider + group sync)
# =============================================================================
# Ptah is the DiscourseConnect SSO provider (GET /api/v1/sso/discourse) and keeps
# the `builders` group in sync with paid membership via the admin API.
#
# BEST-EFFORT / NON-FATAL: when these vars are unset the SSO endpoint returns 403,
# group sync no-ops, and GET /api/v1/members/sessions returns communityUrl: null
# (the members page hides "Open Community"). See docs/deploy/discourse-digitalocean.md.
#
# Base URL of the Discourse instance (also surfaced to members as communityUrl).
DISCOURSE_URL=https://community.ptah.live
# Public origin of THIS license server — composes the SSO login-bounce returnUrl
# instead of trusting the request Host header.
API_PUBLIC_URL=https://api.ptah.live
# Shared DiscourseConnect provider secret. Generate with: openssl rand -hex 32
DISCOURSE_SSO_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# Admin API key for headless `builders` group membership sync (Admin -> API -> Keys).
DISCOURSE_API_KEY=CHANGE_ME_discourse_admin_api_key
DISCOURSE_API_USERNAME=system
DISCOURSE_BUILDERS_GROUP=builders

# =============================================================================
# GOOGLE CALENDAR / MEET — BUILDERS SESSIONS
# =============================================================================
# Recurring live-session schedule surfaced at GET /api/v1/members/sessions; paid
# members are added as attendees by the Paddle provisioning fan-out.
#
# BEST-EFFORT / NON-FATAL: when GOOGLE_OAUTH_* are unset the sessions endpoint
# returns { sessions: [], communityUrl } and attendance sync no-ops.
# See docs/deploy/discourse-digitalocean.md §7 for the one-time OAuth setup.
#
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME_google_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=CHANGE_ME_google_oauth_refresh_token
GOOGLE_CALENDAR_ID=primary
# Master (non-instance) event id of the recurring Builders session. Leave blank
# to disable attendee sync (the sessions list still renders).
BUILDERS_SESSION_EVENT_ID=

# =============================================================================
# LICENSE RESPONSE SIGNING (Ed25519)
# =============================================================================
# Signs license verification responses to prevent MITM attacks.
# The VS Code extension embeds the corresponding public key to verify responses.
#
# Generate a key pair with: npx ts-node scripts/generate-license-keys.ts
# Set the private key here (base64-encoded DER PKCS8)
# Set the public key in libs/shared/src/lib/constants/environment.constants.ts
#
LICENSE_SIGNING_PRIVATE_KEY=CHANGE_ME_generate_with_scripts_generate_license_keys

# =============================================================================
# SENTRY ERROR MONITORING (TASK_2025_251)
# =============================================================================
# Create a Sentry project at https://sentry.io and copy the DSN here.
# When empty, Sentry initialization is skipped (safe for local development).
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# =============================================================================
# MAGIC LINK CONFIGURATION
# =============================================================================
MAGIC_LINK_TTL_MS=300000
