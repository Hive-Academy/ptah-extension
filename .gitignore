# ============================================
# Docker Environment Files
# ============================================
# Docker Compose environment (contains local configuration)
.env.docker

# Production environment (contains secrets)
# Glob so local derivatives are covered too — .env.prod.droplet (pulled off the
# server), .env.prod.bak, etc. The committed template is negated back in.
.env.prod*
!.env.prod.example

# Docker Compose local overrides (user-specific settings)
docker-compose.override.yml

# Database backups
backups/

# Local environment files (contain secrets)
.env

# ============================================
# Build Output
# ============================================
build-output.txt

