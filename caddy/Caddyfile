# Ptah License Server - Caddy Reverse Proxy
#
# Auto-HTTPS via Let's Encrypt (ACME HTTP-01 challenge on port 80).
# HTTP-to-HTTPS redirect is automatic.
# TLS 1.2+ with modern cipher suite (Caddy defaults).
#
# IMPORTANT: The caddy-data volume stores Let's Encrypt certificates.
# Never delete the caddy-data volume in production or certificates will
# need to be re-issued (Let's Encrypt has rate limits).

api.ptah.live {
    request_body {
        max_size 10MB
    }

    reverse_proxy license-server:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    encode gzip

    log {
        output stdout
        format console
    }
}

# NOTE: `community.ptah.live` used to be served here, reverse-proxied to the
# forum container. TASK_2026_177 removed it. Deploying this file REQUIRES that
# the `community.ptah.live` DNS record be gone first — Caddy provisions
# certificates on demand, so a name that still resolves to this host with no
# matching site block produces repeated ACME failures in the log. See
# .ptah/specs/task_2026_177/decommission-runbook.md for the ordered procedure.
