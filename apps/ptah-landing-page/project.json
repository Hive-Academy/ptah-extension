{
  "name": "ptah-landing-page",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/ptah-landing-page/src",
  "tags": ["scope:landing", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/ptah-landing-page",
        "browser": "apps/ptah-landing-page/src/main.ts",
        "server": "apps/ptah-landing-page/src/main.server.ts",
        "outputMode": "static",
        "externalDependencies": ["marked-katex-extension"],
        "polyfills": ["zone.js"],
        "tsConfig": "apps/ptah-landing-page/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ptah-landing-page/public"
          }
        ],
        "styles": ["apps/ptah-landing-page/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "32kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/ptah-landing-page/src/environments/environment.ts",
              "with": "apps/ptah-landing-page/src/environments/environment.production.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "checkout": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/ptah-landing-page/src/environments/environment.ts",
              "with": "apps/ptah-landing-page/src/environments/environment.checkout.ts"
            }
          ]
        }
      }
    },
    "build-demo": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        {
          "projects": ["ptah-extension-webview"],
          "target": "build"
        }
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/scripts/landing/**",
        "{workspaceRoot}/libs/web/landing/src/lib/live-demo/**",
        "{workspaceRoot}/libs/frontend/webview-e2e-harness/src/lib/fonts/**"
      ],
      "outputs": ["{workspaceRoot}/dist/ptah-landing-page/browser/demo"],
      "options": {
        "command": "node scripts/landing/build-live-demo.mjs"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "readyWhen": {
        "signal": true
      },
      "options": {
        "port": 4200,
        "proxyConfig": "apps/ptah-landing-page/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "ptah-landing-page:build:production"
        },
        "development": {
          "buildTarget": "ptah-landing-page:build:development"
        },
        "checkout": {
          "buildTarget": "ptah-landing-page:build:checkout"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "ptah-landing-page:build"
      }
    },
    "test": {
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}/apps/coverage/ptah-landing-page"
      ],
      "options": {
        "passWithNoTests": true
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "ptah-landing-page:build",
        "staticFilePath": "dist/ptah-landing-page/browser",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ngc --noEmit --project apps/ptah-landing-page/tsconfig.app.json"
      }
    }
  }
}
