// Prisma Schema for Ptah License Server
// Database: PostgreSQL with driver adapters (Nx monorepo compatible)
// Prisma 7.1.0+ - URL configured in prisma.config.ts, adapter passed at runtime
//
// IMPORTANT: url field is DEPRECATED in Prisma 7 and should NOT be in schema
// Configure datasource.url in prisma.config.ts instead

datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client"
  output   = "../../../libs/api/core/src/lib/generated-prisma-client"
}

// User model - stores user information for license ownership
// Syncs with WorkOS User Management for authentication
model User {
  id               String         @id @default(uuid()) @db.Uuid
  workosId         String?        @unique @map("workos_id") // WorkOS user ID for sync
  paddleCustomerId String?        @unique @map("paddle_customer_id") // Paddle customer ID for billing
  // Circle community member ID for paid Builders members (headless Admin API v2).
  // Populated when a Builders subscription is provisioned; cleared/ignored on cancel.
  circleMemberId   String?        @map("circle_member_id")
  email            String         @unique
  firstName        String?        @map("first_name")
  lastName         String?        @map("last_name")
  emailVerified    Boolean        @default(false) @map("email_verified")
  // TASK_2025_292: Marketing opt-in state (CAN-SPAM compliance)
  marketingOptIn   Boolean        @default(true) @map("marketing_opt_in")
  unsubscribedAt   DateTime?      @map("unsubscribed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  licenses         License[]
  subscriptions    Subscription[]
  sessionRequests  SessionRequest[]
  memberGroupAssignments MemberGroupAssignment[]
  // TASK_2026_177 Phase 2 — the native community forum (see the models at the
  // end of this file). All four are BACK-RELATIONS ONLY: the FK and its
  // `onDelete` live on the owning model, deliberately split two ways.
  //   topics / posts   -> `SetNull`. Deleting a user must NOT delete the
  //                       conversation; the thread stays readable with a null
  //                       author (A-4), which is also how migrated content is
  //                       represented.
  //   reactions / read -> `Cascade`. A reaction and a read marker are personal
  //                       state with no meaning once the user is gone.
  topics           Topic[]          @relation("TopicAuthor")
  posts            Post[]           @relation("PostAuthor")
  postReactions    PostReaction[]
  topicReadStates  TopicReadState[]

  @@index([workosId])
  @@index([paddleCustomerId])
  @@map("users")
}

// Member cohort/group (e.g. "Founding Members"). Exactly one group is the
// current default (`isDefault`); new paid Builders members are auto-assigned to
// it. Groups are durable cohort identity — assignments survive churn
// (deprovisioning never removes them).
//
// A group used to also carry a column naming a group on the external forum that
// a provisioning fan-out kept in sync. TASK_2026_177 P1b deleted that
// integration, and the `20260805090000_` migration dropped the column. Cohort
// membership is now resolved and rendered in-product: `CohortResolver` turns a
// user's assignments into `cohortKeys`, and the native community surface gates
// category visibility on them (AD-10).
//
// `sessionEventId` makes the weekly live session COHORT-AWARE: two cohorts (e.g.
// English and Arabic) can run concurrently against two different Google Meet
// events. It names that cohort's MASTER recurring Google Calendar event — the
// same kind of id as the `BUILDERS_SESSION_EVENT_ID` env var, which remains the
// fallback for every cohort that leaves this null. A single-cohort deployment
// therefore keeps working with the env var alone and no rows populated here.
model MemberGroup {
  id             String   @id @default(cuid())
  key            String   @unique // stable slug, e.g. 'founding'
  name           String
  description    String?
  sessionEventId String?  @map("session_event_id") // cohort's Google Calendar master event (null = fall back to BUILDERS_SESSION_EVENT_ID)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  assignments MemberGroupAssignment[]
  // Bookkeeping back-relation only — a Pack row labelled with this cohort.
  // Grants nothing: see the Pack model docblock below.
  packs       Pack[]

  @@index([isDefault])
  @@map("member_groups")
}

// Join row linking a User to a MemberGroup. `source` records how the assignment
// was made ('auto_provisioning' from the Builders fan-out, 'admin' from the
// admin panel, 'migration' from a data backfill). One row per (user, group).
model MemberGroupAssignment {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") @db.Uuid
  groupId    String   @map("group_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  source     String // 'auto_provisioning' | 'admin' | 'migration'

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  group MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("member_group_assignments")
}

// TASK_2026_169: A "pack" is a Ptah-authored source-code deliverable — a GitHub
// repository containing a production-shaped codebase plus its Claude plugins and
// MCP servers — shared with a Builders cohort.
//
// DELIVERY HAPPENS ENTIRELY ON GITHUB. The admin invites the cohort's members as
// collaborators, or hands the repo link to the cohort, by hand. There is
// deliberately NO GitHub App integration, no collaborator-invite automation, and
// no storage of members' GitHub handles. `notes` records whichever manual step
// was taken, for the admin's own reference.
//
// ONE PACK = ONE REPO. `repoUrl` is the pack's own dedicated GitHub repository;
// packs never share a repo. Adding a second deliverable means adding a second
// Pack row, not a second URL on this one.
//
// THIS TABLE GATES NOTHING, AND THAT SURVIVES THE CHANNEL CHANGE.
// Ptah never serves pack content and never decides who may access a pack.
// Access is administered ENTIRELY on GitHub. This table exists so the admin has
// one place recording which repo belongs to which cohort.
//
// It is admin-only TODAY. The link used to reach members through the cohort's
// group on the external forum that TASK_2026_177 P1b deleted; Phase 5 replaces
// that channel with an in-product `GET /members/packs` filtered on
// `member_visible` alone (A-1, R5.6). Delivering a link is not granting access,
// so a member-facing READ does not make this table a gate.
//
// `cohortKey` is therefore a BOOKKEEPING LABEL, NOT AN ACCESS CONTROL:
//   null     -> the repo is not tied to a particular cohort.
//   non-null -> the repo was shared with that MemberGroup cohort (on GitHub).
// Changing this field grants and revokes nothing.
model Pack {
  id          String   @id @default(cuid())
  slug        String   @unique // stable lowercase slug, e.g. 'saas-starter'
  title       String
  description String
  repoUrl     String   @map("repo_url") // https://github.com/<owner>/<repo> — one repo per pack
  notes       String? // freeform ADMIN note (e.g. "invites sent 2026-08-01")
  tags        String[] @default([])
  cohortKey   String?  @map("cohort_key") // bookkeeping label only — gates nothing
  createdBy   String?  @map("created_by") // admin email at creation time
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cohort MemberGroup? @relation(fields: [cohortKey], references: [key], onDelete: SetNull)

  @@index([cohortKey])
  @@map("packs")
}

// Subscription model - tracks Paddle subscription state for payment lifecycle
// TASK_2025_121: Added trialEnd field for trial period tracking
model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  paddleSubscriptionId String    @unique @map("paddle_subscription_id")
  paddleCustomerId     String    @map("paddle_customer_id")
  status               String // "active" | "trialing" | "paused" | "canceled" | "past_due"
  priceId              String    @map("price_id")
  currentPeriodEnd     DateTime  @map("current_period_end")
  trialEnd             DateTime? @map("trial_end") // TASK_2025_121: Trial end date (null if not in trial)
  canceledAt           DateTime? @map("canceled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paddleSubscriptionId])
  @@index([userId])
  @@map("subscriptions")
}

// License model - stores license keys with plan, status, and expiration
// TASK_2025_128: Freemium model - Community (free) + Pro (paid)
model License {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  licenseKey String    @unique @map("license_key")
  plan       String // "community" | "builders"
  status     String    @default("active") // "active" | "expired" | "revoked" | "paused"
  // TASK_2025_292: License origin. "paddle" = paid subscription, "complimentary" = admin-issued gift, "manual" = admin-issued refund-in-kind,
  // "signup" = auto-issued free community tier at registration (NOT revenue).
  // ⚠️ The default below is "paddle", so any non-purchase creation path MUST set `source` explicitly or it will be counted as a sale.
  // NOTE: When MRR dashboards are built, they MUST filter `source = 'paddle'` (or join via `subscriptions` which is the correct source of truth).
  source     String    @default("paddle")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String    @default("admin") @map("created_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([licenseKey])
  @@index([userId])
  @@index([status, expiresAt])
  @@index([source])
  @@map("licenses")
}

// FailedWebhook model - stores failed webhook payloads for manual recovery and investigation
// TASK_2025_123: Webhook resilience - store failures for later retry
model FailedWebhook {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @map("event_id")
  eventType    String    @map("event_type")
  rawPayload   Json      @map("raw_payload")
  errorMessage String    @map("error_message")
  stackTrace   String?   @map("stack_trace")
  attemptedAt  DateTime  @map("attempted_at") @default(now())
  retryCount   Int       @default(0) @map("retry_count")
  resolved     Boolean   @default(false)
  resolvedAt   DateTime? @map("resolved_at")

  @@index([eventId])
  @@index([eventType])
  @@index([resolved])
  @@map("failed_webhooks")
}

// SessionRequest model - stores training session registration requests
// Users can request free (community) or paid ($100) 2-hour training sessions
model SessionRequest {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTopicId      String    @map("session_topic_id")
  additionalNotes     String?   @map("additional_notes")
  isFreeSession       Boolean   @default(false) @map("is_free_session")
  status              String    @default("pending") // pending | scheduled | completed | canceled
  paymentStatus       String    @default("none") @map("payment_status") // none | pending | completed
  paddleTransactionId String?   @map("paddle_transaction_id")
  scheduledAt         DateTime? @map("scheduled_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("session_requests")
}

// TASK_2025_292: Append-only audit log for admin actions (user deletion, complimentary license issuance, marketing campaigns, bounce/complaint webhooks, unsubscribe/resubscribe).
// actorEmail is nullable because public unsubscribe + webhook-driven entries have no admin actor.
model AdminAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorEmail     String?  @map("actor_email")
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  targetSnapshot Json?    @map("target_snapshot")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([actorEmail])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_log")
}

// TASK_2025_292: Reusable marketing email templates (sanitised HTML).
model MarketingCampaignTemplate {
  id         String              @id @default(uuid()) @db.Uuid
  name       String              @unique
  subject    String
  htmlBody   String              @map("html_body")
  variables  String[]            @default([])
  createdBy  String?             @map("created_by")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  campaigns  MarketingCampaign[]

  @@index([name])
  @@index([createdAt])
  @@map("marketing_campaign_templates")
}

// TASK_2025_292: Marketing campaign send records. Templates optional because ad-hoc "subject + HTML" sends are permitted.
// Template relation uses onDelete: SetNull so historical campaign rows survive template deletion.
model MarketingCampaign {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  subject           String
  templateId        String?   @map("template_id") @db.Uuid
  segment           String // 'all' | 'buildersActive' | 'communityActive' | 'subscriptionPastDue' | 'custom'
  recipientCount    Int       @default(0) @map("recipient_count")
  sentCount         Int       @default(0) @map("sent_count")
  bouncedCount      Int       @default(0) @map("bounced_count")
  complainedCount   Int       @default(0) @map("complained_count")
  unsubscribedCount Int       @default(0) @map("unsubscribed_count")
  skippedUserIds    String[]  @default([]) @map("skipped_user_ids")
  createdBy         String    @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")

  template MarketingCampaignTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([subject, createdAt])
  @@index([createdBy])
  @@index([createdAt])
  @@map("marketing_campaigns")
}

// Builders waitlist - captures leads for the new premium "Builders" tier.
// Public, un-authenticated signups deduped by lowercased email.
// notifiedAt / convertedAt are lifecycle timestamps the team fills in later
// (notified when checkout opens, converted when they become a paying Builder).
model Waitlist {
  id          String    @id @default(cuid())
  email       String    @unique
  source      String? // origin of the signup: 'landing' | 'pricing' | 'profile' | 'vscode' | ...
  createdAt   DateTime  @default(now()) @map("created_at")
  notifiedAt  DateTime? @map("notified_at")
  convertedAt DateTime? @map("converted_at")

  @@index([createdAt])
  @@index([source])
  @@map("waitlist")
}

// ===========================================================================
// TASK_2026_177 Phase 2 — the native community forum.
//
// Replaces the Discourse integration deleted in Phase 1. Five models, one
// migration (`20260812090000_community_forum`), served by `@ptah-api/forum`.
//
// ⚠️ TWO INDEXES IN THAT MIGRATION ARE INVISIBLE HERE. Prisma cannot express
// `gin_trgm_ops`, so `community_topics_title_trgm` and
// `community_posts_body_trgm` are hand-written SQL. A `prisma migrate diff`
// will therefore NEVER mention them, and a future migration can silently drop
// them. Read the generated SQL before every subsequent migration in this app.
// ===========================================================================

/// Community category. ~10 rows. Visibility is enforced server-side on every
/// read; an invisible category yields 404, never 403 (R1.1.3).
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  /// 'member' | 'cohort' | 'staff' (R1.1.1)
  visibility  String   @default("member")
  /// MemberGroup.key values, ANY-match. AD-10: array not join table.
  /// Empty while visibility != 'cohort'.
  cohortKeys  String[] @default([]) @map("cohort_keys")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  topics Topic[]

  @@index([sortOrder])   // R1.1.4 admin-defined display order
  @@map("community_categories")
}

// Index on visibility/cohortKeys REJECTED: ~10 rows, always read in full and
// filtered in memory-equivalent time.

/// A discussion thread. Carries NO body — post #1 is the body (AD-9).
model Topic {
  id             String    @id @default(cuid())
  categoryId     String    @map("category_id")
  /// Generated at creation, stable for life; a title edit never changes it (R1.2.2).
  slug           String    @unique
  title          String
  /// null for migrated/system content (A-4). Never a fabricated User row.
  authorId       String?   @map("author_id") @db.Uuid
  pinned         Boolean   @default(false)
  locked         Boolean   @default(false)
  /// At most one accepted answer (R1.5.2), enforced by @unique.
  acceptedPostId String?   @unique @map("accepted_post_id")
  /// AD-11. Replies only (excludes post #1 and soft-deleted posts).
  /// Maintained in the same transaction as every post write.
  postCount      Int       @default(0) @map("post_count")
  lastPostedAt   DateTime  @map("last_posted_at")
  editedAt       DateTime? @map("edited_at")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author       User?    @relation("TopicAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  posts        Post[]
  acceptedPost Post?    @relation("AcceptedAnswer", fields: [acceptedPostId], references: [id], onDelete: SetNull)
  readStates   TopicReadState[]

  @@index([categoryId, pinned, lastPostedAt])  // category listing: pinned first, then recency (R1.2.5)
  @@index([pinned, lastPostedAt])              // cross-category feed, same ordering
  @@index([authorId])                          // "My Threads" (R9.2)
  @@map("community_topics")
}

// Index on deletedAt REJECTED: low thousands of rows, always filtered after a
// categoryId/pinned seek. Index on slug is implied by @unique.
//
// `onDelete: Restrict` on `category` is deliberate: R8.2 permits MOVING a topic
// between categories, so a category holding topics must not be deletable out
// from under them. `onDelete: SetNull` on `author` keeps a thread readable
// after a user is deleted — the `User` cascade above would otherwise take the
// whole conversation with them.

/// Every body in the forum: post #1 is the topic's opening body, post N>1 is a
/// reply. parentId non-null = a child reply, indented exactly one level.
/// Depth 3 is unrepresentable: a valid parentId points only at a post whose own
/// parentId is null, enforced and repaired on write (R1.3.3, RK-12).
model Post {
  id           String    @id @default(cuid())
  topicId      String    @map("topic_id")
  parentId     String?   @map("parent_id")
  postNumber   Int       @map("post_number")
  bodyMarkdown String    @map("body_markdown")
  authorId     String?   @map("author_id") @db.Uuid
  editedAt     DateTime? @map("edited_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  topic      Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  parent     Post?          @relation("PostChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children   Post[]         @relation("PostChildren")
  author     User?          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reactions  PostReaction[]
  acceptedOn Topic?         @relation("AcceptedAnswer")

  @@unique([topicId, postNumber])   // MG-1.7 ordering + blocks duplicate numbering
                                    // under concurrent replies (allocated in-transaction)
  @@index([topicId, createdAt])     // thread render — the hottest query in the product
  @@index([authorId])               // R10.2 self-notification suppression + "My Threads"
  @@map("community_posts")
}

// `onDelete: Restrict` on `parent` is a SAFETY NET, not a workflow: nothing
// hard-deletes a post, and if something ever tried, Postgres would refuse
// rather than orphan the children R1.3.5 requires stay readable.

/// R1.4. Fixed server-defined type set; a second identical reaction toggles off
/// by deleting the row (R1.4.1). No free-form emoji (R1.4.3).
model PostReaction {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id") @db.Uuid
  /// 'like' | 'insightful' | 'celebrate' | 'thanks' — 4 types, server-defined.
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])   // R1.4.1 one per member per target per type
  @@index([userId])                  // cascade on user delete
  @@map("community_post_reactions")
}

// A separate @@index([postId]) is REJECTED as redundant: the composite unique
// above is a btree leading with postId, which already serves the per-post
// groupBy that produces reaction counts.

/// A-6: one marker per member per topic. No per-post read receipts.
model TopicReadState {
  userId             String   @map("user_id") @db.Uuid
  topicId            String   @map("topic_id")
  lastReadPostNumber Int      @default(0) @map("last_read_post_number")
  lastReadAt         DateTime @updatedAt @map("last_read_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@map("community_topic_read_state")
}

// No surrogate id and no extra index. The composite PK leads with userId, which
// is exactly the feed query ("every read state for this member, for these topic
// ids"). Unread = Topic.postCount - lastReadPostNumber, clamped at 0 (R1.6.2).
