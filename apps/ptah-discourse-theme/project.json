{
  "name": "ptah-discourse-theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ptah-discourse-theme",
  "tags": ["scope:community", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/ptah-discourse-theme"],
      "options": {
        "cwd": "apps/ptah-discourse-theme",
        "command": "node tools/deploy-theme.mjs --pack-only"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ptah-discourse-theme",
        "command": "node tools/deploy-theme.mjs --url http://localhost:3001"
      },
      "configurations": {
        "production": {
          "command": "node tools/deploy-theme.mjs --url https://community.ptah.live --yes"
        }
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/ptah-discourse-theme",
        "command": "discourse_theme watch ."
      }
    }
  }
}
