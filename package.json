{
  "name": "@ptah-extension/source",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "landing": "cross-env PORT=4200 nx serve ptah-landing-page",
    "docs": "npx nx dev ptah-docs",
    "build": "nx build ptah-electron",
    "build:webview": "nx build ptah-extension-webview",
    "build:webview:dev": "nx build ptah-extension-webview --configuration=development",
    "build:shared": "nx build shared",
    "build:all": "nx run-many -t build",
    "dev": "nx serve:watch ptah-electron",
    "dev:webview": "nx build ptah-extension-webview --watch --configuration=development",
    "dev:all": "nx run-many -t build --watch",
    "lint": "nx run-many -t lint -p ptah-electron ptah-extension-webview shared",
    "lint:webview": "nx lint ptah-extension-webview",
    "lint:shared": "nx lint shared",
    "lint:all": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "verify": "node scripts/verify.mjs",
    "typecheck:affected": "nx affected -t typecheck ",
    "typecheck:webview": "nx run ptah-extension-webview:typecheck",
    "typecheck:shared": "nx run shared:typecheck",
    "typecheck:all": "nx affected -t typecheck",
    "test": "nx run-many -t test -p ptah-electron ptah-extension-webview shared",
    "test:webview": "nx test ptah-extension-webview",
    "test:shared": "nx test shared",
    "test:all": "nx run-many -t test",
    "test:watch": "nx run-many -t test --watch",
    "test:native": "node scripts/test-native.mjs",
    "test:scripts": "jest --config=scripts/jest.config.ts",
    "test:e2e": "jest --config=e2e/jest.config.js --testPathPattern=e2e",
    "clean": "nx reset && rm -rf dist node_modules/.cache",
    "clean:cache": "nx daemon --stop && rm -rf .nx/cache .nx/workspace-data dist/apps/ptah-electron dist/apps/ptah-extension-webview",
    "graph": "nx graph",
    "affected": "nx affected",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "serve:webview": "nx serve ptah-extension-webview",
    "prepare": "husky || true",
    "validate-skill": "npx ts-node scripts/validate-orchestration-skill.ts",
    "manifest:generate": "node scripts/generate-content-manifest.js",
    "manifest:check": "node scripts/generate-content-manifest.js --check",
    "manifest:self-test": "node scripts/generate-content-manifest.js --self-test",
    "gate:eager-closure": "node scripts/eager-closure-gate.js dist/apps/ptah-extension-webview/browser-stats.json",
    "vendor:brand-icons": "node scripts/vendor-brand-icons.mjs",
    "sanitize:sessions": "npx ts-node --project scripts/tsconfig.json scripts/sanitize-claude-sessions.ts",
    "db:drain-observations": "npx ts-node --project scripts/tsconfig.json scripts/drain-observation-queue.ts",
    "usage:report": "npx ts-node --project scripts/tsconfig.json scripts/agent-usage-report.ts",
    "electron:serve": "nx serve ptah-electron",
    "electron:watch": "nx serve:watch ptah-electron",
    "electron:launch": "node apps/ptah-electron/scripts/launch.js",
    "electron:build": "nx build ptah-electron --skip-nx-cache",
    "electron:build:dev": "nx build-dev ptah-electron",
    "electron:package": "nx package ptah-electron",
    "electron:package:local-production": "nx package-local-production ptah-electron",
    "electron:backup:production-data": "node apps/ptah-electron/scripts/backup-local-production-data.js",
    "electron:rebuild": "node apps/ptah-electron/scripts/rebuild-native.js",
    "postinstall": "node apps/ptah-electron/scripts/rebuild-native.js && node apps/ptah-electron/scripts/patch-transformers-onnx-dep.js && node scripts/windows-hide-patch/patch-windows-hide-deps.js",
    "eval:build": "npx ts-node --project scripts/tsconfig.json scripts/build-eval-harness.ts --build",
    "eval:run": "npx ts-node --project scripts/tsconfig.json scripts/build-eval-harness.ts --evaluate"
  },
  "private": true,
