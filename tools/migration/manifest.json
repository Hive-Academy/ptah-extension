{
  "$comment": [
    "Manifest-driven domain extraction plan.",
    "",
    "The array order IS the migration order. A domain may only be extracted once",
    "every domain in its `dependsOn` chain already exists as a real lib.",
    "",
    "Fields:",
    "  name       - domain id, also the Nx project name of the generated lib",
    "  lib        - workspace-relative lib root",
    "  importPath - TS path alias (the ONLY legal way to import the lib; no deep imports)",
    "  platform   - 'web' -> @nx/angular:library, 'api' -> @nx/js:library",
    "  tags       - Nx tags string passed straight to the generator",
    "  app        - workspace-relative source app the files come from",
    "  sources    - app-relative globs. Either a plain string (destination mirrors the",
    "               path relative to <app>/src/app) or { glob, to } where `to` is the",
    "               destination directory under <lib>/src/lib and the structure below",
    "               the glob's static base is preserved.",
    "  dependsOn  - domains that must be extracted first",
    "  selectorPrefixes - (web only, optional) Angular selector prefixes the generated",
    "               lib eslint config must accept. Defaults to [\"app\"].",
    "",
    "Entries with an empty `sources` array are SKELETONS: they document the planned",
    "order but the extractor refuses to run them until they are filled in."
  ],
  "domains": [
    {
      "name": "web-core",
      "lib": "libs/web/core",
      "importPath": "@ptah-web/core",
      "platform": "web",
      "tags": "scope:web,type:util",
      "app": "apps/ptah-landing-page",
      "sources": [
        "src/app/services/auth.service.ts",
        "src/app/services/auth-initializer.service.ts",
        "src/app/services/seo.service.ts",
        "src/app/services/validate-response.ts",
        "src/app/services/subscription-state.service.ts",
        "src/app/services/github-release.service.ts",
        "src/app/services/waitlist.service.ts",
        "src/app/services/paddle-checkout.service.ts",
        "src/app/services/members-api.service.ts",
        "src/app/services/sse-events.service.ts",
        "src/app/interceptors/api.interceptor.ts",
        "src/app/config/api-base-url.token.ts",
        "src/app/guards/auth.guard.ts",
        "src/app/guards/guest.guard.ts",
        "src/app/guards/admin-auth.guard.ts",
        "src/app/config/paddle.config.ts",
        "src/app/config/early-adopter.config.ts",
        "src/app/config/sessions.config.ts",
        "src/app/utils/paddle-validation.util.ts",
        {
          "glob": "src/app/pages/profile/models/license-data.interface.ts",
          "to": "models"
        }
      ],
      "dependsOn": [],
      "selectorPrefixes": ["app", "ptah"]
    },
    {
      "name": "web-ui",
      "lib": "libs/web/ui",
      "importPath": "@ptah-web/ui",
      "platform": "web",
      "tags": "scope:web,type:ui",
      "app": "apps/ptah-landing-page",
      "sources": [
