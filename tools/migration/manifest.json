          "to": "."
        },
        {
          "glob": "src/app/components/footer.component.ts",
          "to": "."
        },
        {
          "glob": "src/app/components/countdown-timer.component.ts",
          "to": "."
        },
        {
          "glob": "src/app/components/console/console-grid-background.component.ts",
          "to": "console"
        }
      ],
      "dependsOn": ["web-core"],
      "selectorPrefixes": ["app", "ptah"]
    },
