{
  "name": "review-eval",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/review-eval",
  "projectType": "application",
  "tags": ["type:tool"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project tools/review-eval/tsconfig.json"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.angular.config.mjs",
        "{workspaceRoot}/eslint.spec-change-detection.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "tools/review-eval",
        "command": "eslint ."
      }
    }
  }
}
