/** One-time history cleanup. No snapshot is eligible without audited provenance. */
import * as fs from 'node:fs';
import * as path from 'node:path';
import * as os from 'node:os';
import { createHash } from 'node:crypto';
import { computeSourceHash } from '../libs/backend/agent-generation/src/lib/services/user-layer/source-hash';
import { verifySkillPipelineArchive } from '../libs/backend/persistence-sqlite/src/lib/skill-pipeline-archive';

export interface ProvenanceEntry {
  snapshot: string;
  source: string;
  sidecar: string;
  operation: 'seed' | 'fast-forward';
  sourceHash: string;
}
export interface PruneEntry { path: string; sha256: string }
export interface PruneManifest { root: string; entries: PruneEntry[] }

function hash(file: string): string {
  return createHash('sha256').update(fs.readFileSync(file)).digest('hex');
}
function isUnder(root: string, target: string): boolean {
  const rel = path.relative(root, target);
  return rel !== '' && rel !== '..' && !rel.startsWith(`..${path.sep}`) && !path.isAbsolute(rel);
}
function files(dir: string): string[] {
  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((item) => {
    const file = path.join(dir, item.name);
    if (item.isSymbolicLink()) throw new Error(`Symlink in history: ${file}`);
    return item.isDirectory() ? files(file) : item.isFile() ? [file] : [];
  });
}
function checkedPath(root: string, target: string): string {
  const absolute = path.resolve(target);
  if (!isUnder(root, absolute) || !absolute.split(path.sep).includes('.history')) {
    throw new Error(`Path outside user history: ${absolute}`);
  }
  let cursor = root;
  for (const part of path.relative(root, absolute).split(path.sep)) {
    cursor = path.join(cursor, part);
    if (fs.existsSync(cursor) && fs.lstatSync(cursor).isSymbolicLink()) throw new Error(`Symlink: ${cursor}`);
  }
  return absolute;
}

/** The ledger must be independently audited: historical snapshots lack operation tags. */
export async function dryRun(root: string, provenance: readonly ProvenanceEntry[]): Promise<PruneManifest> {
  const absoluteRoot = path.resolve(root);
  const entries: PruneEntry[] = [];
  for (const item of provenance) {
    const snapshot = checkedPath(absoluteRoot, item.snapshot);
    if (item.operation !== 'seed' && item.operation !== 'fast-forward') throw new Error('Unknown provenance');
    if (!isUnder(absoluteRoot, path.resolve(item.sidecar))) throw new Error('Sidecar outside user layer');
    if (!fs.existsSync(snapshot) || !fs.existsSync(item.source) || !fs.existsSync(item.sidecar)) continue;
    const sidecar: unknown = JSON.parse(fs.readFileSync(item.sidecar, 'utf8'));
    if (typeof sidecar !== 'object' || sidecar === null || !('sourceHash' in sidecar) ||
      sidecar.sourceHash !== item.sourceHash || !('diverged' in sidecar) || sidecar.diverged !== false ||
      !('lastEnhancedAt' in sidecar) || sidecar.lastEnhancedAt !== null) continue;
    if (await computeSourceHash(snapshot) !== item.sourceHash ||
      await computeSourceHash(item.source) !== item.sourceHash) continue;
    for (const file of fs.statSync(snapshot).isDirectory() ? files(snapshot) : [snapshot]) {
      entries.push({ path: file, sha256: hash(file) });
    }
  }
  entries.sort((a, b) => a.path.localeCompare(b.path));
  if (new Set(entries.map((entry) => entry.path)).size !== entries.length) throw new Error('Duplicate provenance path');
  return { root: absoluteRoot, entries };
}

export async function applyManifest(
  root: string, provenance: readonly ProvenanceEntry[], manifestPath: string, archiveReceiptPath: string,
): Promise<number> {
  verifySkillPipelineArchive(archiveReceiptPath);
  const expected: PruneManifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8')) as PruneManifest;
  const current = await dryRun(root, provenance);
  if (expected.root !== current.root || JSON.stringify(expected.entries) !== JSON.stringify(current.entries)) {
    throw new Error('Manifest contains unknown, changed, or no-longer-eligible hashes');
  }
  for (const entry of expected.entries) {
    checkedPath(current.root, entry.path);
    if (hash(entry.path) !== entry.sha256) throw new Error(`Changed hash: ${entry.path}`);
  }
  for (const entry of expected.entries) fs.unlinkSync(entry.path);
  return expected.entries.length;
}

export async function main(args = process.argv.slice(2)): Promise<void> {
  const get = (name: string): string | undefined => { const i = args.indexOf(name); return i < 0 ? undefined : args[i + 1]; };
  const root = get('--root') ?? path.join(os.homedir(), '.ptah', 'user');
  const provenancePath = get('--provenance');
  if (!provenancePath) throw new Error('--provenance audited ledger is required');
  const provenance = JSON.parse(fs.readFileSync(provenancePath, 'utf8')) as ProvenanceEntry[];
  if (!Array.isArray(provenance)) throw new Error('Invalid provenance ledger');
  if (args.includes('--apply')) {
    const manifest = get('--manifest');
    const archiveReceipt = get('--archive-receipt');
    if (!manifest || !archiveReceipt) throw new Error('Apply requires --manifest and --archive-receipt');
    console.log(JSON.stringify({ deleted: await applyManifest(root, provenance, manifest, archiveReceipt) }));
  } else {
    const manifest = await dryRun(root, provenance);
    const destination = get('--manifest');
    if (destination) fs.writeFileSync(destination, `${JSON.stringify(manifest, null, 2)}\n`, { flag: 'wx', mode: 0o600 });
    console.log(JSON.stringify(manifest, null, 2));
  }
}

if (require.main === module) main().catch((error: unknown) => { console.error(error); process.exitCode = 1; });
