

echo "🚀 Running pre-push checks..."

# DI invariant check — runs on every push regardless of branch (fast, ~2s).
# Asserts every @inject(token) resolves to a register*(token, ...) call.
echo "🔗 Running di-lint (DI invariant check)..."
npx nx run di-lint:lint
if [ $? -ne 0 ]; then
  echo "❌ di-lint failed — an @inject token has no matching registration."
  exit 1
fi

# Electron build gate — runs on every push regardless of branch.
echo "🏗️  Verifying electron main bundle builds + native deps declared..."
if [ "${PTAH_PREPUSH_PARANOID:-0}" = "1" ]; then
  # Compare committed HEAD only; uncommitted edits are not being pushed.
  # Paranoid mode: the affected build AND the packaged-runtime dependency
  # gate. `nx affected -t build` covers compilation but does not run
  # ptah-electron:validate-deps, so a runtime dep missing from
  # apps/ptah-electron/package.json would pass on build alone.
  npx nx affected -t build --base=origin/main --head=HEAD
  if [ $? -ne 0 ]; then
    echo "❌ Affected build failed (PTAH_PREPUSH_PARANOID=1) — fix the compile errors above, then push again."
    exit 1
  fi
  npx nx run ptah-electron:validate-deps
  if [ $? -ne 0 ]; then
    echo "❌ validate-deps failed — a runtime dep is missing from apps/ptah-electron/package.json (would crash with ERR_MODULE_NOT_FOUND in production)."
    exit 1
  fi
else
  npx nx run ptah-electron:validate-deps
  if [ $? -ne 0 ]; then
    echo "❌ Build gate failed — electron main bundle failed to compile OR a runtime dep is missing from apps/ptah-electron/package.json (would crash with ERR_MODULE_NOT_FOUND in production)."
    echo "   Set PTAH_PREPUSH_PARANOID=1 to also run the full affected build."
    exit 1
  fi
fi

# CI (.github/workflows/ci.yml) runs only on pull requests into main, so a
# direct push to main or develop has no other build or typecheck gate.
# --head=HEAD compares committed work only: without it `nx affected` also
# counts uncommitted files, and one unrelated edit to tsconfig.base.json
# once marked all 103 projects affected and made a push take 17 minutes.
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" = "main" ] || [ "$current_branch" = "develop" ]; then
  echo "🏗️ Building and type-checking affected projects..."
  npx nx affected -t build typecheck --base=origin/$current_branch --head=HEAD
  if [ $? -ne 0 ]; then
    echo "❌ Affected build/typecheck failed — fix the errors above, then push again."
    exit 1
  fi
fi

echo "✅ Pre-push checks passed!"
