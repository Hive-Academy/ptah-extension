{
  "name": "@ptah-extension/notification-center",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/notification-center/src",
  "prefix": "ptah",
  "projectType": "library",
  "tags": ["scope:webview", "type:feature"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/frontend/notification-center/jest.config.ts",
        "tsConfig": "libs/frontend/notification-center/tsconfig.spec.json",
        "passWithNoTests": true
      }
    },
    "lint": { "executor": "@nx/eslint:lint" },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ngc --noEmit --project libs/frontend/notification-center/tsconfig.lib.json"
      }
    }
  }
}
