{
  "name": "@ptah-extension/declarative-dashboard",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/declarative-dashboard/src",
  "prefix": "ptah",
  "projectType": "library",
  "tags": ["scope:webview", "type:ui", "platform:angular"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/__mocks__/**/*",
        "{workspaceRoot}/libs/frontend/mcp-apps-page/src/**/*.ts",
        "{workspaceRoot}/libs/frontend/mcp-apps-page/src/**/*.html"
      ],
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ngc --noEmit --project libs/frontend/declarative-dashboard/tsconfig.lib.json"
      }
    }
  }
}
