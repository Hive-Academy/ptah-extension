{
  "name": "@ptah-extension/ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/ui/src",
  "prefix": "ptah",
  "projectType": "library",
  "tags": ["scope:webview", "type:ui"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/frontend/ui/ng-package.json",
        "tsConfig": "libs/frontend/ui/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/frontend/ui/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "jestRuntime",
        "{workspaceRoot}/libs/frontend/core/project.json",
        "{workspaceRoot}/eslint.config.mjs"
      ],
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ngc --noEmit --project libs/frontend/ui/tsconfig.lib.json"
      }
    }
  }
}
