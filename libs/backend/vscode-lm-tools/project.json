{
  "name": "@ptah-extension/vscode-lm-tools",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/vscode-lm-tools/src",
  "projectType": "library",
  "tags": ["scope:extension", "type:feature", "domain:vscode"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/claude-domain",
        "main": "libs/backend/vscode-lm-tools/src/index.ts",
        "tsConfig": "libs/backend/vscode-lm-tools/tsconfig.lib.json",
        "assets": ["libs/backend/vscode-lm-tools/*.md"],
        "format": ["cjs"],
        "external": ["vscode", "tsyringe", "eventemitter3", "rxjs", "minimatch"]
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/__mocks__/**/*",
        "{workspaceRoot}/apps/ptah-cli/src/services/mcp/session-submit.service.spec.ts",
        "{workspaceRoot}/apps/ptah-electron/src/services/electron-ide-capabilities.spec.ts",
        "{workspaceRoot}/libs/backend/memory-curator/src/lib/code-symbol.store.spec.ts",
        "{workspaceRoot}/libs/backend/workspace-intelligence/src/diagnostics/type-script-diagnostics-provider.spec.ts",
        "{workspaceRoot}/libs/backend/workspace-intelligence/src/testing/mcp-contract/mcp-contract.bench.spec.ts",
        "{workspaceRoot}/tools/mcp-bench/baseline/gate-baseline.json",
        "{workspaceRoot}/apps/ptah-extension-vscode/assets/plugins/**/*.md",
        "{workspaceRoot}/.claude/skills/agent-lanes/SKILL.md",
        "{workspaceRoot}/assets/tree-sitter/**/*"
      ],
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/backend/vscode-lm-tools/tsconfig.lib.json"
      }
    }
  }
}
