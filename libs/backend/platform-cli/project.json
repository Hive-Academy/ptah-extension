{
  "name": "@ptah-extension/platform-cli",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/backend/platform-cli/src",
  "tags": ["scope:cli", "type:feature"],
  "targets": {
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/backend/platform-cli/tsconfig.lib.json"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.angular.config.mjs",
        "{workspaceRoot}/eslint.spec-change-detection.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/backend/platform-cli",
        "command": "eslint ."
      }
    }
  }
}
