{
  "name": "@ptah-extension/agent-generation",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/agent-generation/src",
  "projectType": "library",
  "tags": ["scope:extension", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/agent-generation",
        "main": "libs/backend/agent-generation/src/index.ts",
        "tsConfig": "libs/backend/agent-generation/tsconfig.lib.json",
        "assets": [
          "libs/backend/agent-generation/*.md",
          "libs/backend/agent-generation/templates/**/*.template.md"
        ],
        "deleteOutputPath": true,
        "format": ["cjs"],
        "external": ["vscode", "tsyringe", "eventemitter3", "rxjs"]
      }
    },
    "test": {
      "//": "The inputs repeat the @nx/jest targetDefaults entry in nx.json and add the rubric that generation-prompt-rules.spec.ts pins, so a rubric-only edit marks this test affected.",
      "inputs": [
        "default",
        "^production",
        "jestRuntime",
        "{workspaceRoot}/.claude/skills/skill-creator/references/prompt-authoring-rubric.md"
      ],
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/backend/agent-generation/tsconfig.lib.json"
      }
    }
  }
}
