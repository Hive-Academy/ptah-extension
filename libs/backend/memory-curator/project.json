{
  "name": "@ptah-extension/memory-curator",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/backend/memory-curator/src",
  "tags": ["scope:extension", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/memory-curator",
        "main": "libs/backend/memory-curator/src/index.ts",
        "tsConfig": "libs/backend/memory-curator/tsconfig.lib.json",
        "assets": [],
        "format": ["cjs"],
        "external": [
          "vscode",
          "tsyringe",
          "better-sqlite3",
          "sqlite-vec",
          "@huggingface/transformers",
          "ulid"
        ]
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/backend/memory-curator/tsconfig.lib.json"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.angular.config.mjs",
        "{workspaceRoot}/eslint.spec-change-detection.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/backend/memory-curator",
        "command": "eslint ."
      }
    }
  }
}
