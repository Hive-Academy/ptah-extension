{
  "name": "@ptah-extension/agent-sdk",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/agent-sdk/src",
  "projectType": "library",
  "tags": ["scope:extension", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/agent-sdk",
        "main": "libs/backend/agent-sdk/src/index.ts",
        "tsConfig": "libs/backend/agent-sdk/tsconfig.lib.json",
        "assets": ["libs/backend/agent-sdk/*.md"],
        "format": ["cjs"],
        "external": [
          "vscode",
          "tsyringe",
          "eventemitter3",
          "rxjs",
          "@anthropic-ai/claude-agent-sdk"
        ]
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/__mocks__/**/*",
        "{workspaceRoot}/libs/backend/**/*.ts",
        "{workspaceRoot}/libs/backend/**/*.js",
        "{workspaceRoot}/apps/ptah-cli/src/**/*.ts",
        "{workspaceRoot}/apps/ptah-extension-vscode/src/**/*.ts",
        "{workspaceRoot}/apps/ptah-electron/src/**/*.ts",
        "{workspaceRoot}/apps/ptah-electron/src/**/*.js",
        "{workspaceRoot}/apps/ptah-tui/src/**/*.ts"
      ],
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/backend/agent-sdk/tsconfig.lib.json"
      }
    }
  }
}
