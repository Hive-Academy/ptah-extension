{
  "name": "@ptah-extension/vscode-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/vscode-core/src",
  "projectType": "library",
  "tags": ["scope:extension", "type:util"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/vscode-core",
        "main": "libs/backend/vscode-core/src/index.ts",
        "tsConfig": "libs/backend/vscode-core/tsconfig.lib.json",
        "assets": ["libs/backend/vscode-core/*.md"],
        "format": ["cjs"],
        "external": ["vscode", "tsyringe", "eventemitter3", "rxjs"]
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "jestRuntime",
        "{workspaceRoot}/libs/backend/**/*.ts",
        "{workspaceRoot}/apps/**/tokens.ts"
      ],
      "options": {
        "passWithNoTests": true
      }
    },
    "test-real-git": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "jest --config libs/backend/vscode-core/jest.real-git.config.ts",
        "runInBand": true,
        "passWithNoTests": false,
        "env": {
          "TS_NODE_COMPILER_OPTIONS": "{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}"
        }
      },
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project libs/backend/vscode-core/tsconfig.lib.json"
      }
    }
  }
}
