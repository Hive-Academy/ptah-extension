{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2021",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "outDir": "../../../dist/out-tsc",
    "declaration": true,

    // ⚠️ DELIBERATELY NOT COPIED from the `libs/api/*` siblings:
    //   experimentalDecorators / emitDecoratorMetadata — a NestJS decorator
    //     must not compile here. This lib is consumed by BOTH `scope:api` and
    //     `scope:web`; a `@Controller`/`@Injectable`/`@Input` leaking in would
    //     make one side unbuildable.
    //   "types": ["node"] — nothing in `src/lib/**` may touch a Node global.
    //     The structural spec DOES need `node` + `jest`; it gets them from
    //     tsconfig.spec.json, which is the only place they are declared.
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
