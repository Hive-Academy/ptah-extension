{
  "name": "web-panel-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/panel-ui/src",
  "prefix": "app",
  "projectType": "library",
  "tags": ["scope:web", "type:ui"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/web/panel-ui/jest.config.cts",
        "tsConfig": "libs/web/panel-ui/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ngc --noEmit --project libs/web/panel-ui/tsconfig.lib.json"
      }
    }
  }
}
