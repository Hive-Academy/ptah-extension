{
  "name": "api-email",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/email/src",
  "projectType": "library",
  "tags": ["scope:api", "type:util"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config libs/api/email/jest.config.cts",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit --project libs/api/email/tsconfig.lib.json"
      }
    }
  }
}
