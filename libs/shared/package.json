{
  "name": "@ptah-extension/shared",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "sideEffects": false,
  "main": "./index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    "./angular": {
      "types": "./src/angular/index.ts",
      "default": "./src/angular/index.ts"
    },
    ".": {
      "types": "./src/index.d.ts",
      "default": "./index.cjs"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    },
    "./mcp-apps-contracts": {
      "types": "./src/mcp-apps-contracts/index.ts",
      "default": "./src/mcp-apps-contracts/index.ts"
    },
    "./mcp-apps-contracts/surface": {
      "types": "./src/mcp-apps-contracts/surface.index.ts",
      "default": "./src/mcp-apps-contracts/surface.index.ts"
    }
  },
  "peerDependencies": {
    "@angular/core": "22.1.7"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    }
  },
  "dependencies": {
    "uuid": "^11.1.0",
    "zod": "^4.1.12",
    "jsonrepair": "^3.13.1",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  }
}
